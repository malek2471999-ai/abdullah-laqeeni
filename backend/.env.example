# PostgreSQL connection string
DATABASE_URL="postgresql://laqeeni:laqeeni_dev_password@localhost:5432/laqeeni?schema=public"

# Public URL of this API (used in e-mails and QR payloads)
API_PUBLIC_URL="http://localhost:4000"

# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace_me_64_hex_chars"
JWT_REFRESH_SECRET="replace_me_64_hex_chars"
# Separate pepper used to hash device tokens / pairing codes
TOKEN_PEPPER="replace_me_64_hex_chars"
# 32-byte AES key, base64. Generate with: openssl rand -base64 32
LOCATION_ENCRYPTION_KEY="replace_me_base64_32_bytes"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
NODE_ENV=development

# Comma separated list. Use https:// in production.
CORS_ORIGINS="http://localhost:3000"

# Web dashboard URL used in verification/reset links
WEB_PUBLIC_URL="http://localhost:3000"

# Optional Google OAuth client id for "Sign in with Google" (Android/web ID tokens)
GOOGLE_CLIENT_ID=""

# Optional SMTP. In development links are logged and (if EXPOSE_DEV_TOKENS=true) returned.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Abdullah Laqeeni <no-reply@laqeeni.app>"
EXPOSE_DEV_TOKENS=true

# Optional Firebase Admin service account JSON (single line) for push delivery
FIREBASE_SERVICE_ACCOUNT_JSON=""
