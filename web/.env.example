# URL used by the Next.js server (and middleware) to reach the NestJS API.
API_INTERNAL_URL="http://localhost:4000"

# Public URL is only used for documentation links in the UI.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Canonical public URL of this dashboard. Used for sitemap.xml, so it is read at
# build time; rebuild the image when it changes.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: enable "Sign in with Google" by setting the same OAuth web client id
# in the backend (GOOGLE_CLIENT_ID) and here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
